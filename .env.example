# ── Database ───────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@127.0.0.1:3306/letters

# ── Admin ──────────────────────────────────────────────────────
# 管理后台口令。生产环境必须设置，否则服务启动失败。
ADMIN_KEY=change-me

# ── Server ─────────────────────────────────────────────────────
PORT=3000
# 日志目录，默认 ./logs
# LOG_DIR=./logs
